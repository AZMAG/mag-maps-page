{
  "name": "mag-maps-page",
  "version": "6.7.0",
  "date": "2026-09-02",
  "created": "2014-10-21",
  "copyright": "2026",
  "description": "MAG Main Map Page",
  "keywords": [
    "MAG",
    "region",
    "planning",
    "MPO",
    "COG",
    "maps",
    "mapping",
    "state",
    "Arizona"
  ],
  "type": "module",
  "author": "Maricopa Association of Governments (MAG) (https://www.azmag.gov/)",
